# Unified Agent System — Environment Template
# Copy to .env on your laptop or VPS, fill secrets by hand, and run: chmod 600 .env
# NEVER commit .env or paste secrets in chat/logs.

# Environment mode: development (laptop) | production (VPS)
ENV=development
APP_HOST=0.0.0.0
API_PORT=8010
WEB_PORT=3010
DOMAIN=localhost

# Database (PostgreSQL 16 in Docker/VPS; SQLite supported for direct Windows dev)
POSTGRES_USER=unified_agent
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=unified_agent
DATABASE_URL=sqlite:///./data/unified_agent.db

# Redis (leave empty on direct Windows dev to use built-in asyncio event bus)
REDIS_URL=

# Master encryption & signing keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
VAULT_MASTER_KEY=
MAILBOX_ENC_KEY=
JWT_SECRET_KEY=change-me-at-least-32-random-bytes-secret
BACKUP_ENC_KEY=change-me-strong-backup-passphrase

# Model provider API keys (API keys ONLY — never use subscription cookies/OAuth)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Daily router defaults (USD)
BUDGET_USD_DAILY_ANTHROPIC=5.0
BUDGET_USD_DAILY_OPENAI=3.0

# CAPTCHA subsystem (plugin interface — manual human-in-the-loop default)
CAPTCHA_SOLVER=manual
CAPTCHA_MAX_SPEND_USD=0
CAPTCHA_MANUAL_TIMEOUT_SEC=900

# Mail & Google Account OAuth (optional Gmail API client creds; user tokens encrypted in DB)
MAIL_MODE=imap
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3010/api/google-accounts/oauth/callback
VERIFICATION_CODE_TIMEOUT_SEC=600

# Notifications (optional Telegram bot for manual captcha / 2FA code / daily 08:00 report alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local browser-worker / noVNC SSH tunnel host label shown in UI instructions
VPS_SSH_HOST=deploy@YOUR_SERVER_IP
NOVNC_LOCAL_PORT=6080

# Frontend API proxy target
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_WS_API_PORT=8010
BACKEND_INTERNAL_URL=http://127.0.0.1:8010
